        "class Circle:\n",
        "     def __init__(self, radius,pi=3.14):\n",
        "         self.pi =pi\n",
        "         self.radius = radius\n",
        "\n",
        "     def area(self):\n",
        "         return self.pi * self.radius ** 2\n",
        "\n",
        "\n",
        "  c1 = Circle(3)\n",
        "print(\"Area of circle:\", c1.area())"
