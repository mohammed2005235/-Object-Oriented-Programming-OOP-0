class Calculator:
    def add(self,a,b):
        return a + b 
    def multiply(self, a, b):
      return a* b 
    def subtract(self,a ,b):
      return a - b 
    def divide(self, a, b):
        return a / b 
    def modulus(self, a, b):
        return a % b
    def divide2(self,a,b):
      return a // b

calc = Calculator()
print("add=",calc.add(8,2))
print("multiply=" ,calc.multiply(7,6))
print("subtract=" ,calc.subtract(7, 6))
print("divide=" ,calc.divide(10, 2))
print("modulus=" ,calc.modulus(10, 3))
print("divide2=" ,calc.divide2(5, 5))
